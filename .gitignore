# Build artifacts
*.o
*.res
*.zip
*.tar.gz

# Project DLLs (build artifacts) — but keep UE4SS bundle DLLs
*.dll
!UE4SS/**/*.dll

# Project executables (build artifacts)
*.exe
!UE4SS/**/*.exe

# Backups / temp
*.bak
*.bak*
*.tmp
*.log
tmp_engine_classes.hpp

# Release / build directories
releases/
release/
build/

# Distribution directory (regenerated by package.sh or CI)
dist/
dist-minimap/

# Large map textures (downloaded via scripts/download_assets.sh)
assets/maps/*.rgba
web/assets/map/*.webp

# Python bytecode
__pycache__/
*.pyc

# Runtime files (generated at runtime)
imgui.ini
paltrainer.json
commands.json
minimap_prefs.json
paltrainer_log.txt
favorites.json

# UE4SS binary bundle — distributed in releases
# (uncomment to exclude from repo if too large)
# UE4SS/

# IDE / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sln
*.vcxproj*

# Secrets / env
.env

# Debug / marker files
impl_*.txt
imgui_err_search.txt
ini_check.txt
install-report.txt
lua_overview.txt
marker_test.txt
patch_done.txt
patch_fn_check.txt
pcm_overview.txt
pm_lines.txt
read_install.txt
revert_*.txt
